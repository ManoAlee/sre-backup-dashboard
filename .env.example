# ==============================================================================
# SRE Backup & Infrastructure Observability Platform — Environment Configuration
# ==============================================================================

# Application Core Settings
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=change-me-to-a-secure-random-64-char-string
PORT=5000
HOST=0.0.0.0

# Brand & Multi-Tenant White-Labeling
SRE_PLATFORM_NAME="SRE Backup & Infrastructure Observability Hub"
SRE_ENVIRONMENT_NAME="Production Core"
SRE_ORGANIZATION="Enterprise Infrastructure"

# Storage & Infrastructure Nodes (Customizable IPs/Hostnames)
STORAGE_NAS_HOST="192.168.10.200"
STORAGE_NAS_PORT=22
STORAGE_PRIMARY_PATH="/mnt/storage_vault"
STORAGE_VM_SNAPSHOTS_PATH="/mnt/backup_vms"

GATEWAY_ROUTER_IP="192.168.10.1"
IDENTITY_AD_IP="192.168.10.6"
DATABASE_CLUSTER_IP="192.168.10.2"
LINUX_APP_SERVER_IP="192.168.10.7"

# Notification & SMTP Engine
SMTP_SERVER="smtp.enterprise.local"
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER="sre-notifications@enterprise.local"
SMTP_PASSWORD="change-me"
SMTP_FROM="sre-platform@enterprise.local"
ALERT_RECIPIENTS="sre-team@enterprise.local,noc-lead@enterprise.local"

# Security & SRE Thresholds
BACKUP_MAX_AGE_HOURS_CLOUD=48
BACKUP_MAX_AGE_HOURS_LOCAL=192
SHANNON_ENTROPY_MIN_THRESHOLD=7.2
KOPIA_REPOSITORY_PATH="/mnt/backup_vms"
